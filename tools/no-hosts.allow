# Exceptions to tools/check-no-hosts.sh ("All configuration in settings.toml (no hardcoded
# configuration)"), one per line: `<glob><TAB><regex>`. The glob matches `<tree>/<path>` (tree:
# app, lepic, lepic-flutter); text the regex matches on a line of such a file is ignored. Every
# exception has a comment above it saying why. Every address, port, timeout and limit lives in
# the settings files (docs/settings-file.md); these are protocol, other programs' facts, or
# example data in screenshots.

# The Epic node's own API paths (its protocol, like https's port): every node answers them.
app/lib/src/node/node_api.dart	'/v1/(version|status)'|'/v2/\$api'
app/lib/src/contacts.dart	'/v2/foreign'
# Send's clean-up line names the wallet API path it leaves out of a pasted address (the wallet
# adds it): the same protocol path, as words.
app/lib/l10n/app_*	/v2/foreign

# The old Epic Cash GUI's own defaults (its local node on each network), read to import its
# wallets: facts about another program, not ours to configure.
app/lib/src/legacy/gui_rules.dart	(?<![0-9])(3413|13413|23413)(?![0-9])

# The operating systems' privileged range ends at 1023: the lowest port the built-in node may be
# given is the systems' rule, not a value anyone configures.
app/lib/src/settings_file/settings_layout.dart	userPortMin = 1024

# The example value of a port placeholder in the strings' metadata (the Link · HTTP port
# messages): a hint for translators, never shown or dialled.
app/lib/l10n/app_*	"example": "3415"
app/lib/l10n/desk/*	"example": "3415"

# Example data in screenshots, the tour and the mock wallets (contacts' Link · HTTP addresses,
# a home node, peers and node log lines): shown, never connected to.
app/lib/src/desktop/data/mock_wallet.dart	:(3413|3415)(?![0-9])
app/lib/src/desktop/data/desk_node.dart	:3414(?![0-9])
app/lib/src/desktop/screens/transfer/shots.dart	:3415(?![0-9])
app/lib/src/desktop/screens/invoices/shots_core.dart	:3415(?![0-9])
app/lib/src/desktop/screens/invoices/shots_req.dart	:3415(?![0-9])
app/lib/src/web/preview.dart	:3413(?![0-9])

# LEPIC: the Epic node's foreign API path, its protocol (ADR 0030 keeps it in code).
lepic/crates/lepic-foreign/src/server.rs	"/v2/foreign"
lepic/crates/lepic-node/src/rpc.rs	"/v2/foreign"
lepic/crates/lepic-tor/src/transport.rs	"/v2/foreign"

# LEPIC: 3415 is what a peer's http:// address without a port means, in every Epic wallet
# (protocol, ADR 0030), and its documentation; the generated Dart copies the doc comments.
lepic/crates/lepic-foreign/src/url.rs	(?<![0-9])3415(?![0-9])
lepic/crates/lepic-ffi/src/api/http.rs	(?<![0-9])3415(?![0-9])
lepic/crates/lepic-cli/src/cli.rs	missing port is 3415
lepic-flutter/lib/src/rust/api/wallet.dart	(?<![0-9])3415(?![0-9])
lepic-flutter/lib/src/rust/frb_generated.dart	(?<![0-9])3415(?![0-9])

# LEPIC: documentation examples of a node API root (an example.invalid-style name, never dialled).
lepic/crates/lepic-ffi/src/api/types.rs	node\.example:3413
lepic/crates/lepic-node/src/http.rs	node\.example:3413
lepic-flutter/lib/src/rust/api/types.dart	node\.example:3413

# LEPIC CLI tests that check the values of the shipped, embedded config files.
lepic/crates/lepic-cli/src/app_config.rs	"epicbox\.epiccash\.com"
lepic/crates/lepic-cli/src/settings_file.rs	"epicbox\.epiccash\.com"

# A doc comment's example of a LAN address (lanNetworkKey's input), never connected to.
app/lib/src/phone_http.dart	192\.168\.1\.20:3415

# LEPIC's log ring redaction tests: host-like words the redactor must replace.
lepic/crates/lepic-telemetry/src/mobile.rs	epic\.cash

# Explanations the user reads, never dialled: the info line of the "Use status.btlabs.uk"
# setting names the site its public list comes from (the setting's own name), and Help names
# the node's default API and P2P ports (3413, 3414) where it explains the Ports row. The
# addresses the app uses come from the settings files.
app/lib/l10n/*	status\.btlabs\.uk
app/lib/src/help/help_*.dart	(?<![0-9])(3413|3414)(?![0-9])

# The test drivers' control ids (g4.<screen>.<control>: `g4.send.to`, `g4.restore.info`): dotted
# like a host, ending in what reads as a top-level domain; never an address.
app/lib/src/trust_ids.dart	(?<![A-Za-z0-9_.])g4(\.[a-z][A-Za-z0-9]*)+

# The SVG namespace of the contact label marks: the XML namespace's name, never dialled.
app/lib/src/ui/contact_label_mark.dart	xmlns="http://www\.w3\.org/2000/svg"
