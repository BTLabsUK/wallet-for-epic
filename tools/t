# SPDX-License-Identifier: Apache-2.0
"""tools/t: the one command to run the app's Flutter tests (docs/TESTING.md).

  tools/t [affected] [--base <ref>] [--list]   the tests the change reaches, plus the sentinels
  tools/t file <path>[:<line>|:<name>] ...     one test file, or one test in it
  tools/t full                                 every test/**/*_test.dart, slowest first
  tools/t goldens --update <test or png> ...   rewrite goldens (Linux only), then show what moved
  tools/t flaky [--days N]                     files and tests that both failed and passed with
                                               the same inputs (the run history, tlib/history.py)

Options: --no-cache runs files that passed before; --dart-define K=V (repeatable); -j N.
A file that passed with the same inputs (tools/tlib/cache.py) is not run again: when nothing is
left to run it prints `cached green (<key>)`. Results: a short summary on stdout (failures first,
each `file:line` and the start of its message) and .test-results/latest.json with every failure.
Exit status: 0 green, 1 red, 2 usage or infrastructure error.

Before a run it checks that app/third_party's clones are at their pins (tools/lepic.sh sync moves
them). While it runs it prints a progress line every 30 s, and it stops the run when 3 files
failed to load (WFE_T_FAILFAST=N; 0 never stops): the compiler died or the code does not compile.
"""
import argparse
import contextlib
import copy
import fcntl
import json
import os
import shutil
import signal
import subprocess
import sys
import threading
import time

TOOLS = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(TOOLS)
sys.path.insert(0, TOOLS)

import flutter_test_order as order  # noqa: E402
from tlib import budget, cache, graph as g, history, report, select, variants, watch  # noqa: E402

APP = os.path.join(ROOT, "app")
RESULTS = os.path.join(ROOT, ".test-results")
TIMES = os.environ.get("WFE_TEST_TIMES", os.path.expanduser("~/.cache/wfe-test-times.json"))
START_MARK = "@@tools-t-started@@"


class Usage(Exception):
    pass


class Infra(Exception):
    pass


def toolchain_env():
    """The environment tools/env.sh makes (flutter on PATH, FLUTTER_ROOT)."""
    r = subprocess.run(["bash", "-c", '. "$1" && env -0', "_", os.path.join(TOOLS, "env.sh")],
                       capture_output=True)
    if r.returncode != 0:
        raise Infra("tools/env.sh failed: " + r.stderr.decode(errors="replace").strip())
    env = {}
    for item in r.stdout.split(b"\0"):
        k, _, v = item.decode(errors="replace").partition("=")
        if k:
            env[k] = v
    return env


def rel_app(path):
    """'app/test/x_test.dart' -> 'test/x_test.dart'."""
    return path[len("app/"):] if path.startswith("app/") else path


def resolve_path(arg):
    """A repository path (app/...) for a path given relative to the cwd, the repo or app/."""
    for base in (os.getcwd(), ROOT, APP):
        p = os.path.normpath(os.path.join(base, arg))
        if os.path.exists(p):
            rel = os.path.relpath(p, ROOT).replace(os.sep, "/")
            if rel.startswith(".."):
                continue
            return rel
    raise Usage(f"no such file: {arg}")


def split_target(arg):
    """('path', line or None, name or None) for path[:line|:name]."""
    path, sep, rest = arg.partition(":")
    if not sep:
        return path, None, None
    if rest.isdigit():
        return path, int(rest), None
    return path, None, rest


def name_at_line(path, line):
    """The name of the test or group declared at or above `line`: what --plain-name takes."""
    import re
    decl = re.compile(r"""\b(?:testWidgets|test|group)\(\s*r?(['"])(.*?)(?<!\\)\1""")
    found = None
    with open(os.path.join(ROOT, path), encoding="utf-8") as f:
        for i, text in enumerate(f, 1):
            if i > line:
                break
            m = decl.search(text)
            if m:
                found = m.group(2)
    if not found:
        raise Usage(f"{path}:{line}: no test or group starts at or above that line; give the name")
    if "$" in found:
        found = found.split("$")[0].rstrip()
        if len(found) < 5:
            raise Usage(f"{path}:{line}: the test's name is built at run time; give a part of it")
    return found


@contextlib.contextmanager
def worktree_lock():
    """One flutter run per worktree at a time: two share app/.dart_tool."""
    os.makedirs(RESULTS, exist_ok=True)
    f = open(os.path.join(RESULTS, ".lock"), "w")
    try:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("tools/t: another tools/t runs in this worktree; waiting for it", file=sys.stderr)
            fcntl.flock(f, fcntl.LOCK_EX)
        yield
    finally:
        f.close()


def lepic_library():
    """The Linux LEPIC library the binding's build hook bundles (tools/lepic.sh build linux)."""
    return os.path.join(APP, "third_party", "lepic-flutter", "native", "x86_64-unknown-linux-gnu",
                        "liblepic_ffi.so")


def use_lepic_library():
    """For `full`: the tests that open a wallet on the real core (vault_test.dart, the *_live_test.dart
    files that need no node or funds) run instead of skipping, when WFE_LEPIC_LIB names
    the library; the live files
    that also need WFE_LIVE_DIR stay skipped. A path set by the caller is kept. The cache key hashes the library's bytes (tlib/cache.py), so a green result is never reused across libraries."""
    if "WFE_LEPIC_LIB" in os.environ or not sys.platform.startswith("linux"):
        return
    env = toolchain_env()
    prepare(env)  # builds the library when this worktree has none
    if os.path.exists(lepic_library()):
        os.environ["WFE_LEPIC_LIB"] = lepic_library()


def prepare(env):
    """The binding clone and `flutter pub get`, when missing or older than the pubspec."""
    if not os.path.isdir(os.path.join(APP, "third_party", "lepic-flutter")):
        print("tools/t: app/third_party is missing: tools/lepic.sh sync", file=sys.stderr)
        r = subprocess.run([os.path.join(TOOLS, "lepic.sh"), "sync"], env=env,
                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        if r.returncode:
            raise Infra("tools/lepic.sh sync failed:\n" + r.stderr[-2000:])
    stale = watch.stale_pins(ROOT)
    if stale:
        # A clone behind its pin fails every file to load ("The Dart compiler exited unexpectedly")
        raise Infra("\n".join(stale))
    lib = lepic_library()
    if sys.platform.startswith("linux") and not os.path.exists(lib):
        # The binding's build hook needs the library to compile any test. From the prebuilt cache
        # this is a copy (docs/TESTING.md, "LEPIC builds are shared"); a miss builds it once.
        print("tools/t: no LEPIC library in this worktree: LEPIC_SHARED=1 tools/lepic.sh build linux",
              file=sys.stderr)
        r = subprocess.run([*heavy(env), os.path.join(TOOLS, "lepic.sh"), "build", "linux"],
                           env={**env, "LEPIC_SHARED": env.get("LEPIC_SHARED", "1")},
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        if r.returncode:
            raise Infra("tools/lepic.sh build linux failed:\n" + r.stdout[-2000:])
    cfg = os.path.join(APP, ".dart_tool", "package_config.json")
    newest = max(os.path.getmtime(os.path.join(APP, p)) for p in ("pubspec.yaml", "pubspec.lock"))
    if not os.path.exists(cfg) or os.path.getmtime(cfg) < newest:
        r = subprocess.run(["flutter", "pub", "get"], cwd=APP, env=env, capture_output=True, text=True)
        if r.returncode:
            raise Infra("flutter pub get failed:\n" + (r.stdout + r.stderr)[-2000:])


def heavy(env):
    """build-slot, when this machine has it: a shared slot for heavy work (a nested call runs in
    the caller's slot)."""
    # ~/.local/bin, where it lives, is not on every PATH (systemd units, plain ssh)
    path = env.get("PATH", "") + os.pathsep + os.path.expanduser("~/.local/bin")
    found = shutil.which("build-slot", path=path)
    return [found] if found else []


def jobs(n_files, wanted):
    if wanted:
        return max(1, min(wanted, n_files, budget.MAX_JOBS))
    j = os.environ.get("FLUTTER_TEST_JOBS")
    if j and j.isdigit() and int(j) > 0:
        return min(int(j), budget.MAX_JOBS)
    # Three quarters of the logical CPUs, at most MAX_JOBS (10: on 16 threads the full suite ran
    # 9:16 against 10:50 at 6, no more flakes). Three quarters of 16 threads kept a 16-thread
    # machine at 96 % CPU.
    return max(1, min(n_files, budget.MAX_JOBS, (os.cpu_count() or 4) * 3 // 4))


def run_flutter(files, env, args, name_filter, update_goldens, run=None, events_name="latest.events.jsonl",
                jobs_cap=None):
    """Runs flutter test on app-relative `files`; returns (Run, rc, seconds, queue seconds).
    With `run`, its events are added to that Run (a retry, ids shifted) and written to `events_name`.
    Prints a progress line every watch.PROGRESS_S seconds. When watch.failfast_threshold() files
    have failed to load, stops flutter and sets run.aborted to the first one's (file, message)."""
    events_path = os.path.join(RESULTS, events_name)
    cmd = ["flutter", "test", "--no-pub", "--reporter", "json",
           f"--concurrency={min(jobs(len(files), args.jobs), jobs_cap or 1 << 30)}"]
    if name_filter:
        cmd.append(f"--plain-name={name_filter}")
    if update_goldens:
        cmd.append("--update-goldens")
    for d in args.dart_define:
        cmd.append(f"--dart-define={d}")
    cmd += files
    wrapped = [*([] if args.no_heavy else heavy(env)),
               "sh", "-c", f'echo {START_MARK}; exec "$@"', "sh", *cmd]
    run = run or report.Run(APP)
    w = watch.Watch(len(files), watch.failfast_threshold())
    t0 = time.time()
    started = None
    proc = subprocess.Popen(wrapped, cwd=APP, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True, errors="replace", start_new_session=True)
    stop = threading.Event()

    def progress():
        while not stop.wait(watch.PROGRESS_S):
            print(w.line(time.time() - (started or t0)), flush=True)

    threading.Thread(target=progress, daemon=True).start()

    def over_run_limit(message):
        print(f"tools/t: budget: {message}", file=sys.stderr, flush=True)
        run.aborted = {"file": "(run limit)", "message": message, "count": 1}
        stop_group(proc)

    sampler = budget.Sampler(APP, over_run_limit).start()
    try:
        with open(events_path, "w", encoding="utf-8") as ev:
            for line in proc.stdout:
                if started is None and line.strip() == START_MARK:
                    started = time.time()
                    continue
                if line.startswith("{"):
                    ev.write(line)
                    with contextlib.suppress(ValueError):
                        e = json.loads(line)
                        if isinstance(e, dict) and w.feed(e):
                            run.aborted = {"file": w.load_failures[0][0], "message": w.load_failures[0][1],
                                           "count": len(w.load_failures)}
                            stop_group(proc)
                run.feed_line(line)
        rc = proc.wait()
    except KeyboardInterrupt:
        stop_group(proc)
        raise
    finally:
        stop.set()
        MEASURED.extend(sampler.stop())
    end = time.time()
    started = started or t0
    try:
        order.record(TIMES, events_path, APP)
    except (OSError, ValueError):
        print("tools/t: could not keep this run's file times", file=sys.stderr)
    return run, rc, end - started, started - t0


def stop_group(proc):
    """SIGTERM to flutter's process group, SIGKILL when it is still there 10 s later."""
    with contextlib.suppress(ProcessLookupError):
        os.killpg(proc.pid, signal.SIGTERM)
    try:
        proc.wait(timeout=10)
    except subprocess.TimeoutExpired:
        with contextlib.suppress(ProcessLookupError):
            os.killpg(proc.pid, signal.SIGKILL)
        proc.wait()


MAX_RETRY_FILES = 20
MEASURED = []  # budget.Sampler's files of this tools/t process
RETRY_JOBS = 2


def git_sha():
    try:
        return select.git(ROOT, "rev-parse", "--short=10", "HEAD").strip()
    except Exception:  # noqa: BLE001 (history only; any git trouble leaves it blank)
        return ""


def retry_infra(run, rc, ordered, outcomes, env, args, name_filter, update_goldens, tag=""):
    """Runs the files that failed for infrastructure reasons once more, by themselves (a smaller
    `--concurrency`), and replaces their results in `run`. Returns (retried {file: reason}, second
    outcomes {file: outcome}, rc of the retry or None)."""
    infra = sorted(f for f, o in outcomes.items() if o["result"] == "infra")
    if run.aborted or not infra or len(infra) > MAX_RETRY_FILES:
        return {}, {}, None
    retried = {f: outcomes[f]["reason"] for f in infra}
    print("tools/t: infrastructure failure, retrying once: " +
          ", ".join(f"{f} ({r[:80]})" for f, r in retried.items()), file=sys.stderr)
    run.drop_files(infra)
    run.offset += 1_000_000
    _, rc2, _, _ = run_flutter(infra, env, args, name_filter, update_goldens, run=run,
                               events_name=f"latest{tag}.retry.events.jsonl", jobs_cap=RETRY_JOBS)
    return retried, run.file_outcomes(infra, rc2), rc2


def write_latest(data, tag=""):
    os.makedirs(RESULTS, exist_ok=True)
    tmp = os.path.join(RESULTS, ".latest.json.tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=1)
    os.replace(tmp, os.path.join(RESULTS, f"latest{tag}.json"))


def execute(mode, tests, gr, args, extra=(), name_filter=None, update_goldens=False, tag=""):
    """Runs the repo-relative `tests` with the cache; prints the summary; returns the exit code.
    `tag` (".notor") names the result files of a second pass: latest<tag>.json, latest<tag>.events.jsonl."""
    try:
        watch.failfast_threshold()
    except ValueError as e:
        raise Usage(str(e)) from None
    env = toolchain_env()
    flutter_root = env.get("FLUTTER_ROOT", os.path.expanduser("~/flutter"))
    files = select.repo_files(ROOT)
    hasher = cache.Hasher(ROOT, files)
    use_cache = not (args.no_cache or update_goldens)
    ctx = cache.context_key(ROOT, env, flutter_root, args.dart_define, name_filter)
    whole_ctx = cache.context_key(ROOT, env, flutter_root, args.dart_define) if name_filter else ctx
    keys, whole_keys = {}, {}
    for t in tests:
        clo, dfiles, ddirs = gr.deps(t)
        keys[t] = cache.file_key(ctx, hasher, clo, dfiles, ddirs)
        whole_keys[t] = cache.file_key(whole_ctx, hasher, clo, dfiles, ddirs) if name_filter else keys[t]
    cached = [t for t in tests if use_cache and (cache.lookup(keys[t]) or cache.lookup(whole_keys[t]))]
    to_run = [t for t in tests if t not in cached]
    all_key = cache.combined(keys[t] for t in tests)[:16]
    latest = {"command": "tools/t " + " ".join(sys.argv[1:]), "mode": mode, "key": all_key,
              "time": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "files_cached": [rel_app(t) for t in cached],
              "files_run": [rel_app(t) for t in to_run], "notes": list(extra)}
    if not to_run:
        latest.update(status="cached", exit=0, counts={"passed": 0, "skipped": 0, "failed": 0},
                      duration_s=0, queue_s=0, failures=[])
        write_latest(latest, tag)
        print(f"cached green ({all_key}): {len(tests)} files passed before with these inputs; --no-cache runs them")
        return 0

    prepare(env)
    ordered = order.order([rel_app(t) for t in to_run], order.read_times(TIMES))
    print(f"tools/t {mode}: {len(ordered)} files to run, {len(cached)} cached; "
          f"events: .test-results/latest{tag}.events.jsonl", flush=True)
    run, rc, seconds, queue = run_flutter(ordered, env, args, name_filter, update_goldens,
                                        events_name=f"latest{tag}.events.jsonl")
    started_at = time.time() - seconds - queue
    outcomes = run.file_outcomes(ordered, rc)
    if run.aborted:
        # the files stopped part-way are not results: keep them out of the history
        outcomes = {f: o for f, o in outcomes.items() if o["result"] != "infra"}
    first_outcomes = dict(outcomes)
    retried, second, rc2 = ({}, {}, None) if update_goldens else retry_infra(
        run, rc, ordered, outcomes, env, args, name_filter, update_goldens, tag)
    if retried:
        outcomes.update(second)
        if all(o["result"] == "pass" for o in outcomes.values()) and not run.failures():
            rc, run.success = 0, True  # the retry settled the only failures: infrastructure
        extra = [*extra, *(f"retried after an infrastructure failure: {f} ({r})"
                           for f, r in retried.items())]
        latest["notes"] = list(extra)
    counts = run.counts()
    failures = run.failures()
    history.append(history_records(mode, started_at, keys, first_outcomes, second, retried))
    if run.aborted:
        status, code = "aborted", 2
        failures.insert(0, {"file": run.rel(run.aborted["file"]), "line": None,
                            "name": f"run aborted: {run.aborted['count']} files failed to load",
                            "message": "\n".join(run.aborted["message"].splitlines()[:report.MESSAGE_LINES]),
                            "fix": None})
    elif rc == 79 and not failures:
        # flutter test's "No tests were found": a name that matches nothing, or browser-only files
        status, code = "error", 2
        run.other.append("no test ran: the name matches no test, or the file runs only in a browser "
                         "(flutter test --platform chrome <file>)")
    elif run.success is None and not failures:
        status, code = "error", 2
    elif rc == 0 and run.success and not failures:
        status, code = "green", 0
    else:
        status, code = "red", 1
    if status == "error" or (status == "red" and not failures):
        failures.append({"file": "", "line": None, "name": f"flutter test exited {rc}",
                         "message": "\n".join(run.other[-20:]), "fix": None})
    if use_cache:
        for f in run.files_green(ordered):
            t = "app/" + f
            cache.store_green(keys[t], {"file": f, "key": keys[t], "time": latest["time"],
                                        "root": ROOT, "filter": name_filter})
        cache.prune()
    latest.update(status=status, exit=code, counts=counts, duration_s=round(seconds, 1),
                  queue_s=round(queue, 1), failures=failures, events=f".test-results/latest{tag}.events.jsonl")
    write_latest(latest, tag)
    head = (f"tools/t {mode}: {status.upper()}  {counts['passed']} passed, {counts['skipped']} skipped, "
            f"{counts['failed']} failed; {len(to_run)} files run, {len(cached)} cached; "
            f"{report.clock(seconds)} (queue {round(queue)}s)")
    if status == "aborted":
        lines = [head, *extra,
                 f"tools/t: run aborted as a systematic failure: {run.aborted['count']} files failed to load "
                 f"(WFE_T_FAILFAST={watch.failfast_threshold()}; 0 never stops). The first, "
                 f"{run.rel(run.aborted['file'])}:"]
        lines.extend("    " + x[:200] for x in run.aborted["message"].splitlines()[:8])
    elif status == "error":
        lines = [head, *extra, f"flutter test exited {rc} before any test ran; its last lines:"]
        lines.extend("    " + x[:200] for x in run.other[-12:])
    else:
        lines = report.summary(head, status, counts, failures, seconds, extra, list_all=(mode == "full"))
    print("\n".join(lines))
    print("details: .test-results/latest.json")
    return code


def history_records(mode, started_at, keys, first, second, retried):
    """One history line per file run; a retried file has its two attempts."""
    sha, out = git_sha(), []
    for attempt, outcomes in ((1, first), (2, second)):
        for f, o in outcomes.items():
            t = "app/" + f
            out.append(history.record(started_at, ROOT, sha, mode, keys.get(t, ""), f, o["result"],
                                      o.get("duration_s", 0), o.get("failing", ()), attempt,
                                      o.get("reason") or None))
    return out


def cmd_flaky(args):
    since = time.time() - args.days * 86400
    recs = history.read(since=since)
    runs = len(recs)
    flaky = history.flaky(recs)
    if not flaky:
        print(f"tools/t flaky: no flake in {runs} file results of the last {args.days} days "
              f"({history.path()})")
        return 0
    print(f"tools/t flaky: {len(flaky)} entries in {runs} file results of the last {args.days} days "
          f"(same inputs, both results; {history.path()})")
    for e in flaky:
        what = e["test"] or "(any test in the file)"
        print(f"  {e['fails']} fail / {e['passes']} pass  app/{e['file']}: {what}  last fail {e['last_fail'][:16]}")
    return 0


def cmd_affected(args):
    base = select.merge_base(ROOT, args.base)
    changed = select.changed_files(ROOT, base)
    gr = g.Graph(ROOT, select.repo_files(ROOT))
    sel = select.select(ROOT, changed, base=base, graph=gr, closure=args.closure)
    tests, slow = sorted(sel.tests), []
    if not args.closure:
        tests, slow = budget.drop_slow(tests, set(changed), budget.read_allow(ROOT))
    if slow:
        sel.notes.append(f"{len(slow)} slow tests left to the nightly and the candidate ({budget.ALLOW})")
    n_sent = sum(1 for r in sel.tests.values() if r == "sentinel")
    line = (f"selection: {len(tests)} tests ({len(tests) - n_sent} reached by the change, {n_sent} sentinels) "
            f"for {len(changed)} changed files vs {args.base} ({base[:10]})")
    if args.list:
        print(line)
        for n in sel.notes:
            print(f"note: {n}")
        if len(tests) <= 30 or args.verbose:
            for t in tests:
                print(f"  {rel_app(t)}  <- {sel.tests[t]}")
        else:
            by = {}
            for t in tests:
                by.setdefault(sel.tests[t], []).append(t)
            for reason, ts in sorted(by.items(), key=lambda x: -len(x[1]))[:10]:
                print(f"  {len(ts):4d} tests <- {reason}")
            if len(by) > 10:
                print(f"  … {len(by) - 10} more reasons; --list -v lists every test")
        return 0
    return execute("affected", tests, gr, args, extra=[line, *(f"note: {n}" for n in sel.notes)])


def cmd_file(args):
    if not args.targets:
        raise Usage("tools/t file <path>[:<line>|:<name>] ...")
    gr = g.Graph(ROOT, select.repo_files(ROOT))
    tests, names = [], set()
    for target in args.targets:
        path, line, name = split_target(target)
        p = resolve_path(path)
        if not (p.startswith("app/") and p.endswith(".dart")):
            raise Usage(f"{target}: not a Dart test under app/")
        if line is not None:
            name = name_at_line(p, line)
        if name:
            names.add(name)
        tests.append(p)
    if len(names) > 1:
        raise Usage("one test name per run")
    return execute("file", sorted(set(tests)), gr, args, name_filter=next(iter(names), None))


def cmd_full(args):
    """Every test file in the default build, then the files that read torBuilt in the build without
    Tor (`--dart-define=WFE_TOR=false`, tlib/variants.py). latest.json has the first pass and,
    under `notor`, the second; the exit code is the worse of the two."""
    files = select.repo_files(ROOT)
    gr = g.Graph(ROOT, files)
    use_lepic_library()
    code = execute("full", gr.tests(), gr, args)
    if code == 2:
        return code  # aborted or an infrastructure error: the second pass would meet the same
    if args.dart_define and any(d.startswith("WFE_TOR=") for d in args.dart_define):
        return code  # the caller chose the variant: one pass
    notor = variants.notor_tests(ROOT, files)
    if not notor:
        return code
    print(f"\ntools/t full: second pass, the build without Tor (--dart-define={variants.NOTOR_DEFINE}), "
          f"{len(notor)} files that read torBuilt")
    second = copy.copy(args)
    second.dart_define = [*args.dart_define, variants.NOTOR_DEFINE]
    code2 = execute("full-notor", notor, gr, second, tag=".notor")
    try:
        with open(os.path.join(RESULTS, "latest.json"), encoding="utf-8") as f:
            latest = json.load(f)
        with open(os.path.join(RESULTS, "latest.notor.json"), encoding="utf-8") as f:
            latest["notor"] = json.load(f)
        if code2 and not code:
            latest.update(status="red" if code2 == 1 else "error", exit=code2)
        write_latest(latest)
    except (OSError, ValueError):
        pass
    return max(code, code2)


def cmd_goldens(args):
    if not args.update or not args.targets:
        raise Usage("tools/t goldens --update <test file or golden png> ...")
    if not sys.platform.startswith("linux"):
        raise Usage("goldens are made on Linux only (the fonts they were drawn with)")
    gr = g.Graph(ROOT, select.repo_files(ROOT))
    tests = set()
    for target in args.targets:
        p = resolve_path(target)
        if p.endswith(".png"):
            users = [t for t in gr.tests() if p in gr.deps(t)[1] or
                     any(p.startswith(d + "/") for d in gr.deps(t)[2])]
            if not users:
                raise Usage(f"{target}: no test names this golden")
            tests.update(users)
        else:
            tests.add(p)
    code = execute("goldens", sorted(tests), gr, args, update_goldens=True)
    moved = select.git(ROOT, "status", "--short", "--", "app/test").splitlines()
    moved = [m for m in moved if m.endswith(".png")]
    print(f"goldens changed: {len(moved)}" + "".join(f"\n  {m}" for m in moved[:12]))
    if moved:
        print("look at each image before you commit it")
    return code


def budget_gate(code, args):
    """A new or changed test file over its budget fails the run (tlib/budget.py); no flag skips it."""
    changed = set(select.changed_files(ROOT, select.merge_base(ROOT, args.base)))
    os.makedirs(RESULTS, exist_ok=True)
    broken = budget.gate(RESULTS, MEASURED, changed, budget.read_allow(ROOT))
    for m in broken:
        print(f"tools/t: over budget: {m} (make it cheaper, then tools/t file --no-cache it; "
              f"or an exception with its reason in {budget.ALLOW})", file=sys.stderr)
    return code or (1 if broken else 0)


def main(argv):
    p = argparse.ArgumentParser(prog="tools/t", add_help=True,
                                description="Run the app's Flutter tests (docs/TESTING.md).")
    p.add_argument("command", nargs="?", default="affected", choices=["affected", "file", "full", "goldens", "flaky"])
    p.add_argument("targets", nargs="*")
    p.add_argument("--base", default=os.environ.get("CHECK_BASE", "main"))
    p.add_argument("--list", action="store_true", help="affected: print the selection, run nothing")
    p.add_argument("--closure", action="store_true",
                   help="affected: every test the import graph reaches, no limit (never between releases)")
    p.add_argument("-v", "--verbose", action="store_true", help="--list: every test, not a count per cause")
    p.add_argument("--no-cache", action="store_true")
    p.add_argument("--update", action="store_true", help="goldens: rewrite them")
    p.add_argument("--dart-define", action="append", default=[])
    p.add_argument("-j", "--jobs", type=int, default=None)
    p.add_argument("--days", type=int, default=30, help="flaky: how far back to look")
    p.add_argument("--no-heavy", action="store_true", help="do not take a build-slot slot")
    try:
        args = p.parse_args(argv)
    except SystemExit as e:
        return 0 if e.code == 0 else 2
    try:
        if args.command != "file" and args.command != "goldens" and args.targets:
            raise Usage(f"tools/t {args.command} takes no paths")
        with worktree_lock() if not (args.list or args.command == "flaky") else contextlib.nullcontext():
            if args.command == "flaky":
                return cmd_flaky(args)
            code = {"affected": cmd_affected, "file": cmd_file, "full": cmd_full,
                    "goldens": cmd_goldens}[args.command](args)
            return code if args.list else budget_gate(code, args)
    except Usage as e:
        print(f"tools/t: {e}", file=sys.stderr)
        return 2
    except (Infra, RuntimeError, OSError) as e:
        print(f"tools/t: {e}", file=sys.stderr)
        write_latest({"command": "tools/t " + " ".join(argv), "status": "error", "exit": 2,
                      "failures": [{"file": "", "line": None, "name": "infrastructure", "message": str(e)[:2000]}]})
        return 2
    except KeyboardInterrupt:
        print("tools/t: interrupted", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
