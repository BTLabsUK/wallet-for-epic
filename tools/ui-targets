#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""The UI target registry's one tool. Any UI change ends with `tools/ui-targets check`.

tools/rellib/drivers/trust_ids.json is the one list of what a driver touches. The app reads it through
the generated app/lib/src/trust_ids.g.dart, the drivers through core/targets.py.

  tools/ui-targets check                  fails with file, id and fix; names the driver steps hit
  tools/ui-targets gen                    writes the Dart constants from the registry
  tools/ui-targets rename OLD NEW         the registry, every driver and the app, in one go
  tools/ui-targets add ID [--screen S] [--role R] [--family desktop,android] [--keys a,b] [--copy]
                                          a new entry and its constant; says what to do next
"""
import argparse
import ast
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
REG = "tools/rellib/drivers/trust_ids.json"
DART = "app/lib/src/trust_ids.g.dart"
LIB = "app/lib"
ARB = "app/lib/l10n/app_en.arb"
DRIVERS = "tools/rellib/drivers"
COPY_RX = re.compile(r"""(?:\b(?:copy|regex|_text)\([^"\n]*|\.(?:text|pattern)\()"([a-z]\w+)\"""")
KEYS_RX = re.compile(r"^\w*_KEYS = [({].*?[)}]$", re.M | re.S)
ID_RX = re.compile(r"^(g4|pair|link|tx|inv)(\.[A-Za-z0-9_*-]+)+$")
KINDS = ("control", "copy", "group", "template")
PHONE_FILES = ("core/phone.py", "core/phone_lane.py")
# TrustIds helpers: a use of one places every id under its prefix; hand-kept in step with HELPERS below
PLACED_BY = (("shellNav", "g4.nav."), ("settingsSection", "g4.settings.section."), ("levelStop", "g4.level.stop."),
             ("nodeList", "g4.server.node"), ("epicboxList", "g4.server.epicbox"), ("nodeList", "g4.server.search"))
HELPERS = """
  static const nodeList = TrustServerIds(picker: serverNode, field: serverSearch, row: serverNodeRow, add: serverNodeAdd);
  static const epicboxList = TrustServerIds(picker: serverEpicbox, field: serverSearch, row: serverEpicboxRow, add: serverEpicboxAdd);

  /// A rail place: `g4.nav.<DeskSection.name>`.
  static String shellNav(String section) => 'g4.nav.$section';

  /// A Settings page of the desktop (`settingsNode` is `node`) or a group of the phone's hub
  /// (`SettingsSection.name`): `g4.settings.section.<name>`.
  static String settingsSection(String name) {
    final bare = name.startsWith('settings') && name.length > 8 ? name.substring(8) : name;
    return 'g4.settings.section.${bare[0].toLowerCase()}${bare.substring(1)}';
  }

  /// A level's stop on the dial: `g4.level.stop.<1-3>`.
  static String levelStop(int level) => 'g4.level.stop.$level';
"""


def path(rel):
    return os.path.join(ROOT, rel)


def read(rel):
    with open(path(rel), encoding="utf-8") as f:
        return f.read()


def load():
    return json.loads(read(REG))["controls"]


def save(controls):
    lines = [json.dumps(c, ensure_ascii=False) for c in controls]
    with open(path(REG), "w", encoding="utf-8") as f:
        f.write('{"version": 2, "controls": [\n' + ",\n".join(lines) + "\n]}\n")


def kind(c):
    return c.get("kind", "control")


def family(c):
    return c.get("family", ["desktop", "android"])


def const_name(tid):
    parts = re.split(r"[._-]", tid.replace(".*", "").removeprefix("g4."))
    return parts[0] + "".join(p[0].upper() + p[1:] for p in parts[1:])


def generated(controls):
    ids = [c["id"] for c in controls if kind(c) == "control"]
    out = ["// GENERATED by tools/ui-targets from tools/rellib/drivers/trust_ids.json. Do not edit.",
           "part of 'trust_ids.dart';", "",
           "/// The ids of one server list (node or Epicbox).",
           "class TrustServerIds {",
           "  const TrustServerIds({required this.picker, required this.field, required this.row, required this.add});",
           "  final String picker;", "  final String field;", "  final String row;", "  final String add;", "}", "",
           "abstract final class TrustIds {"]
    out += ["  static const %s = '%s';" % (const_name(i), i) for i in ids]
    for c in controls:
        if kind(c) == "template":
            prefix, rest = c["id"].split("*", 1)
            out.append("  static String %sAt(Object value) => '%s$value%s';" % (const_name(c["id"]), prefix, rest))
    out.append(HELPERS.rstrip("\n"))
    out += ["", "  /// Every id above, spelled out.", "  static const all = <String>["]
    out += ["    '%s'," % i for i in ids]
    out += ["  ];", "}", ""]
    return "\n".join(out)


def dart_files(*roots):
    for root in roots:
        for d, _, names in os.walk(path(root)):
            for n in names:
                if n.endswith(".dart") and not n.endswith((".g.dart", "trust_ids.dart")) and "/l10n" not in d:
                    yield os.path.relpath(os.path.join(d, n), ROOT)


def app_places(controls):
    """{const: {family: [file:line]}} of every TrustIds use under app/lib."""
    out = {}
    rx = re.compile(r"\bTrustIds\.(\w+)")
    for f in dart_files(LIB):
        for no, line in enumerate(read(f).split("\n"), 1):
            for m in rx.finditer(line):
                fams = ("desktop",) if f.startswith(LIB + "/src/desktop/") else ("desktop", "android")
                for fam in fams:
                    out.setdefault(m.group(1), {}).setdefault(fam, []).append("%s:%d" % (f, no))
    return out


def driver_files():
    for d, _, names in os.walk(path(DRIVERS)):
        if "__pycache__" in d or "/tests" in d:
            continue
        for n in sorted(names):
            if n.endswith(".py") and n != "standin.py":  # its T is a TCP server of the stand-in, no target
                yield os.path.relpath(os.path.join(d, n), ROOT)


def is_phone(f):
    return f.endswith(PHONE_FILES)


def driver_uses(files):
    """-> (uses {id: [(file, line, const)]}, prefixes {prefix: file}, problems). The T calls are read
    from the syntax tree, so a target made up at run time or given a label is caught."""
    uses, prefixes, problems = {}, {}, []
    for f in files:
        tree = ast.parse(read(f))
        for n in ast.walk(tree):
            for t in ast.iter_child_nodes(n):
                t.parent = n
        for n in ast.walk(tree):
            if not isinstance(n, ast.Call):
                continue
            name = getattr(n.func, "id", getattr(n.func, "attr", ""))
            if name in ("T", "T_phone") and not f.endswith("core/targets.py"):
                a = n.args[0] if n.args else None
                if n.keywords or len(n.args) != 1 or not isinstance(a, ast.Constant):
                    problems.append(("%s:%d" % (f, n.lineno), "T(...)",
                                     "a target with a computed id or fields of its own",
                                     'write T("the.id"); fields belong in %s; data rows use .of(data) or .at(value)' % REG))
                    continue
                parent = getattr(n, "parent", None)
                const = parent.targets[0].id if isinstance(parent, ast.Assign) and isinstance(parent.targets[0], ast.Name) else ""
                uses.setdefault(a.value, []).append((f, n.lineno, const))
            elif name == "under" and n.args and isinstance(n.args[0], ast.Constant):
                prefixes[n.args[0].value] = f
    return uses, prefixes, problems


def steps_for(tid, uses, files):
    """The driver steps that use `tid`: its constant's uses, each with its method and step name."""
    out = []
    for f, line, const in uses.get(tid, ()):
        if not const:
            out.append("%s:%d" % (f, line))
            continue
        hit = False
        for g in files:
            src = read(g)
            if not re.search(r"\b%s\b" % const, src):
                continue
            tree = ast.parse(src)
            for fn in ast.walk(tree):
                if isinstance(fn, ast.FunctionDef) and any(isinstance(x, ast.Name) and x.id == const for x in ast.walk(fn)):
                    steps = sorted({k.value.value for c in ast.walk(fn) if isinstance(c, ast.Call) for k in c.keywords
                                    if k.arg == "step" and isinstance(k.value, ast.Constant)})
                    out.append("%s:%d %s%s" % (g, fn.lineno, fn.name, " (steps %s)" % ", ".join(steps[:4]) if steps else ""))
                    hit = True
        if not hit:
            out.append("%s:%d %s" % (f, line, const))
    return sorted(set(out))


def driver_copy(files):
    """(file, line, ARB key) of every text a driver asserts: `copy`/`regex` calls and *_KEYS tables."""
    out = []
    for f in files:
        src = read(f)
        for m in COPY_RX.finditer(src):
            out.append((f, src.count("\n", 0, m.start()) + 1, m.group(1)))
        for m in KEYS_RX.finditer(src):
            for k in re.finditer(r'"([a-z]+[A-Z]\w*)"', m.group(0)):
                out.append((f, src.count("\n", 0, m.start() + k.start()) + 1, k.group(1)))
    return out


def walk(root):
    """Which targets the seeded tours put on stage: reads the `ids` of each shot's .json under `root`
    (tools/dry-walk.sh writes them). Every target a driver uses must show, or carry "walk": false."""
    seen = {"desktop": set(), "android": set()}
    shots = 0
    for d, _, names in os.walk(root):
        fam = "android" if os.sep + "phone" in d else "desktop"
        for n in names:
            if n.endswith(".json"):
                with open(os.path.join(d, n), encoding="utf-8") as f:
                    got = json.load(f)
                shots += 1
                seen[fam] |= set(got.get("ids", ()))
    if not shots:
        print("ui-targets walk: no shots under %s" % root)
        return 1
    controls = load()
    files = list(driver_files())
    uses, prefixes, _ = driver_uses(files)
    used = set(uses)
    for c in controls:
        if any(c["id"].startswith(p) for p in prefixes):
            used.add(c["id"])
    out, known = 0, 0
    for c in controls:
        if kind(c) != "control" or c["id"] not in used:
            continue
        for fam in family(c):
            if c["id"] in seen[fam]:
                if c.get("walk") is False:
                    print("%s (%s): the walk reached it now, drop its \"walk\": false" % (c["id"], fam))
                continue
            if c.get("walk") is False:
                known += 1
                continue
            out += 1
            s = steps_for(c["id"], uses, files)
            print("%s (%s): no screen of the tour shows it\n    fix: put it back on its screen, or update %s"
                  % (c["id"], fam, "; ".join(s) or "its driver step"))
    print("ui-targets walk: %d shots, %d ids on stage, %d driver targets missing, %d the tours cannot reach"
          % (shots, len(seen["desktop"] | seen["android"]), out, known))
    return 1 if out else 0


def check():
    controls = load()
    arb = json.loads(read(ARB))
    files = list(driver_files())
    uses, prefixes, bad = driver_uses(files)
    used = set(uses)
    for c in controls:
        if any(c["id"].startswith(p) for p in prefixes):
            used.add(c["id"])
    for c in controls:
        if c["id"] in used:
            used |= set(c.get("ids", ()))
    places = app_places(controls)
    ids = [c["id"] for c in controls]
    by_id = {c["id"]: c for c in controls}
    reg_at = {json.loads(l.rstrip(",\n"))["id"]: n for n, l in enumerate(read(REG).split("\n")[1:], 2) if l.startswith("{")}

    def at(tid):
        return "%s:%d" % (REG, reg_at.get(tid, 1))

    def where(c):
        """Why the check cares: the driver steps that lean on it."""
        s = steps_for(c["id"], uses, files)
        return "driver steps to update: " + "; ".join(s) if s else ""

    seen, names = set(), {}
    for c in controls:
        i = c["id"]
        if i in seen:
            bad.append((at(i), i, "listed twice in the registry", "delete one of the two entries"))
        seen.add(i)
        if not ID_RX.match(i):
            bad.append((at(i), i, "not a registry id", "ids read g4|pair|link|tx|inv.<screen>.<control>"))
        if kind(c) not in KINDS:
            bad.append((at(i), i, "kind %s" % kind(c), "kind is one of %s" % ", ".join(KINDS)))
        if kind(c) == "control":
            other = names.setdefault(const_name(i), i)
            if other != i:
                bad.append((at(i), i, "same Dart constant as %s" % other, "rename one: tools/ui-targets rename"))
        if kind(c) == "group":
            for m in c.get("ids", ()):
                if m not in by_id:
                    bad.append((at(i), i, "group member %s is not in the registry" % m, "add it or take it out of the group"))
        if kind(c) == "template" and "*" not in i:
            bad.append((at(i), i, "a template without *", "put a * where the data goes"))
        if kind(c) == "copy" and not any(k in arb for k in c.get("keys", ())):
            k = ", ".join(c.get("keys", ())) or "none"
            bad.append((at(i), i, "copy with no key in %s (keys: %s)" % (ARB, k),
                        "set `keys` to the ARB key the app shows here. %s" % where(c)))
        if kind(c) == "control":
            const = const_name(i)
            pl = places.get(const, {})
            helped = [h for h, p in PLACED_BY if i.startswith(p)]
            if not pl:
                for h in helped:
                    pl = places.get(h, {})
                    if pl:
                        break
            for fam in family(c):
                if fam not in pl:
                    bad.append((at(i), i, "no control carries it in the %s app" % fam,
                                "put TrustId(TrustIds.%s, child: ...) or semanticsId: TrustIds.%s on the control, or remove the "
                                "entry with tools/ui-targets. %s" % (const, const, where(c))))
            sites = sorted({p.rsplit(":", 1)[0] for v in pl.values() for p in v})
            if len(sites) > 1 and not helped and not c.get("many"):
                same = [s for s in sites if "/desktop/" in s], [s for s in sites if "/desktop/" not in s]
                if len(same[0]) > 1 or len(same[1]) > 1:
                    bad.append((at(i), i, "on more than one control: %s" % ", ".join(sites),
                                'one control, one id; for the same control on several screens set "many": true'))
        if i not in used and c.get("driver", True) and kind(c) != "copy":
            bad.append((at(i), i, "no driver uses it", 'use it, remove it, or mark an app-only id "driver": false'))
        if i not in used and kind(c) == "copy":
            bad.append((at(i), i, "no driver checks this text", "remove the entry"))
        if i in used and c.get("driver") is False:
            bad.append((at(i), i, 'a driver uses it but it says "driver": false', "drop the flag"))
    for i, us in uses.items():
        if i not in by_id:
            for f, line, _ in us:
                bad.append(("%s:%d" % (f, line), i, "not in the registry", "tools/ui-targets add %s, or use the id it was renamed to" % i))
            continue
        for f, line, _ in us:
            fam = "android" if is_phone(f) else "desktop"
            if fam not in family(by_id[i]):
                bad.append(("%s:%d" % (f, line), i, "a %s driver uses a target the registry gives only %s" % (fam, family(by_id[i])),
                            "add %s to its family, with the id on that app's control" % fam))
    for f in dart_files(LIB):
        for no, line in enumerate(read(f).split("\n"), 1):
            m = re.search(r"""['"]((?:g4|pair|link|tx|inv)\.[a-zA-Z]+\.[A-Za-z0-9_.]+)['"]""", line)
            if m and m.group(1) in by_id:
                bad.append(("%s:%d" % (f, no), m.group(1), "an id spelled out in the app",
                            "use TrustIds.%s" % const_name(m.group(1))))
    for f, no, key in driver_copy(files):
        if key not in arb:
            bad.append(("%s:%d" % (f, no), key, "a driver reads text the app no longer has (%s)" % ARB,
                        "use the key the app shows now, or take the check out of the driver step"))
    want = generated(controls)
    try:
        have = read(DART)
    except OSError:
        have = ""
    if have != want:
        bad.append((DART, "-", "out of date with the registry", "run tools/ui-targets gen"))
    for loc, i, what, fix in bad:
        print("%s: %s: %s\n    fix: %s" % (loc, i, what, fix))
    print("ui-targets: %d entries, %d problem%s" % (len(controls), len(bad), "" if len(bad) == 1 else "s"))
    return 1 if bad else 0


def gen():
    with open(path(DART), "w", encoding="utf-8") as f:
        f.write(generated(load()))
    print("wrote", DART)
    return 0


def rename(old, new):
    """Exact text replacement of the id and its constant; nothing else moves."""
    controls = load()
    if not any(c["id"] == old for c in controls):
        print("%s is not in the registry" % old)
        return 1
    if any(c["id"] == new for c in controls):
        print("%s is already in the registry" % new)
        return 1
    for c in controls:
        if c["id"] == old:
            c["id"] = new
        if old in c.get("ids", ()):
            c["ids"] = [new if x == old else x for x in c["ids"]]
    save(controls)
    a, b = const_name(old), const_name(new)
    touched = []
    for f in list(dart_files(LIB, "app/test", "app/tool")):
        s = read(f)
        t = re.sub(r"\bTrustIds\.%s\b" % a, "TrustIds." + b, s).replace("'%s'" % old, "'%s'" % new)
        if t != s:
            with open(path(f), "w", encoding="utf-8") as out:
                out.write(t)
            touched.append(f)
    for f in driver_files():
        s = read(f)
        t = s.replace('"%s"' % old, '"%s"' % new)
        if t != s:
            with open(path(f), "w", encoding="utf-8") as out:
                out.write(t)
            touched.append(f)
    gen()
    print("renamed %s to %s in %s and:" % (old, new, REG))
    print("\n".join("  " + f for f in touched))
    return check()


def add(a):
    controls = load()
    if any(c["id"] == a.id for c in controls):
        print("%s is already in the registry" % a.id)
        return 1
    c = {"id": a.id, "screen": a.screen or a.id.split(".")[-2]}
    if a.copy:
        c["kind"] = "copy"
    if a.family != "desktop,android":
        c["family"] = a.family.split(",")
    if a.role != "button":
        c["role"] = a.role
    if a.keys:
        c["keys"] = a.keys.split(",")
    controls.append(c)
    save(controls)
    gen()
    if a.copy:
        print('added. Use it in the driver as T("%s").' % a.id)
    else:
        print('added. In the app: TrustId(TrustIds.%s, child: ...) or semanticsId: TrustIds.%s. In the driver: T("%s").'
              % (const_name(a.id), const_name(a.id), a.id))
    return 0


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("check")
    sub.add_parser("gen")
    r = sub.add_parser("rename")
    r.add_argument("old")
    r.add_argument("new")
    n = sub.add_parser("add")
    n.add_argument("id")
    n.add_argument("--screen", default="")
    n.add_argument("--role", default="button")
    n.add_argument("--family", default="desktop,android")
    n.add_argument("--keys", default="")
    n.add_argument("--copy", action="store_true")
    w = sub.add_parser("walk")
    w.add_argument("dir")
    a = p.parse_args()
    if a.cmd == "check":
        return check()
    if a.cmd == "gen":
        return gen()
    if a.cmd == "walk":
        return walk(a.dir)
    if a.cmd == "rename":
        return rename(a.old, a.new)
    return add(a)


if __name__ == "__main__":
    sys.exit(main())
