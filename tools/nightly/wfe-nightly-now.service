# Epic Wallet nightly full check of local main, started by hand:
#   systemctl --user start --no-block wfe-nightly-now.service
# Same run as wfe-nightly.service, but no busy check: it waits for a build-slot build slot.
# Installed by tools/nightly/install.sh; runs the installed copy, never the worktree's.
[Unit]
Description=Epic Wallet nightly full check of main (by hand, waits for a build slot)

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.local/lib/wfe-nightly/nightly.py --wait-slot
TimeoutStartSec=infinity
Nice=10
