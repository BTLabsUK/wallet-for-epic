# SPDX-License-Identifier: Apache-2.0
# Four tries a night (local time); a try skips when main is unchanged or the machine is busy, so a
# busy night still gets a later one. Missed tries are not made up (Persistent=false).
[Unit]
Description=Epic Wallet nightly full check of main

[Timer]
OnCalendar=*-*-* 02,03,04,05:30:00
Persistent=false
Unit=wfe-nightly.service

[Install]
WantedBy=timers.target
