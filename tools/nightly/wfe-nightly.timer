# SPDX-License-Identifier: Apache-2.0
# A try every hour at :30. By day it skips (nightly.py: `daytime`), unless no run has finished for
# 24 h: then it runs at any hour and waits for a build slot (catch-up). A try also skips when main
# is unchanged or a tools/rel run is active. Missed tries are not made up (Persistent=false).
[Unit]
Description=Epic Wallet nightly full check of main

[Timer]
OnCalendar=*-*-* *:30:00
Persistent=false
Unit=wfe-nightly.service

[Install]
WantedBy=timers.target
