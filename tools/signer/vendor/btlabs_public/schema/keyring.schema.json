{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://btlabs-epic.github.io/schema/btlabs-keyring-1.schema.json",
  "title": "BT Labs public keyring",
  "description": "FORMAT.md §2. Bundled in every client. keyid = first 16 hex of SHA-256(raw public key).",
  "type": "object",
  "required": ["keys"],
  "properties": {
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["keyid", "rank", "public_key", "label"],
        "properties": {
          "keyid": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
          "rank": {"type": "integer", "minimum": 1},
          "public_key": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"},
          "label": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"}
        }
      }
    }
  }
}
