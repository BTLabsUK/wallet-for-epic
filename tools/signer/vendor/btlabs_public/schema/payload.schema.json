{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://btlabs-epic.github.io/schema/btlabs-public-1.schema.json",
  "title": "BT Labs public file, payload schema 1",
  "description": "The signed payload of btlabs.json (FORMAT.md §3). Unknown fields are allowed and ignored by clients.",
  "type": "object",
  "required": ["schema", "serial", "issued_at", "expires_at", "publisher", "donations", "links", "infrastructure"],
  "properties": {
    "schema": {"const": 1},
    "serial": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "publisher": {
      "type": "object",
      "required": ["name", "legal_name", "website"],
      "properties": {
        "name": {"$ref": "#/$defs/text64"},
        "legal_name": {"$ref": "#/$defs/text64"},
        "website": {"$ref": "#/$defs/url"}
      }
    },
    "donations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "coin", "network", "method", "address", "name", "note"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "coin": {"$ref": "#/$defs/id"},
          "network": {"$ref": "#/$defs/id"},
          "method": {"$ref": "#/$defs/id"},
          "address": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[\\x21-\\x7e]+$"},
          "name": {"$ref": "#/$defs/text64"},
          "note": {"$ref": "#/$defs/text280"}
        }
      }
    },
    "links": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "kind", "label", "url"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["website", "github", "telegram", "support", "status", "explorer", "docs", "social", "other"]},
          "label": {"$ref": "#/$defs/text64"},
          "url": {"$ref": "#/$defs/url"}
        }
      }
    },
    "infrastructure": {
      "type": "object",
      "required": ["nodes", "epicbox_relays", "services"],
      "properties": {
        "nodes": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["id", "chain", "url", "operator"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "chain": {"$ref": "#/$defs/chain"},
              "url": {"$ref": "#/$defs/url"},
              "operator": {"$ref": "#/$defs/text64"}
            }
          }
        },
        "epicbox_relays": {
          "type": "array",
          "maxItems": 64,
          "description": "In order of preference, best first.",
          "items": {
            "type": "object",
            "required": ["chain", "host", "operator"],
            "properties": {
              "chain": {"$ref": "#/$defs/chain"},
              "host": {"$ref": "#/$defs/host"},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535, "default": 443},
              "operator": {"$ref": "#/$defs/text64"}
            }
          }
        },
        "services": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["id", "kind", "url"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "kind": {"enum": ["status", "explorer", "other"]},
              "chain": {"$ref": "#/$defs/chain"},
              "url": {"$ref": "#/$defs/url"}
            }
          }
        },
        "onions": {
          "type": "array",
          "maxItems": 32,
          "description": "Tor onion services of BT Labs' own hosts. Optional.",
          "items": {
            "type": "object",
            "required": ["id", "service", "host", "port", "onion", "onion_port", "tls"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "service": {"enum": ["epicbox", "node", "support", "status", "other"]},
              "host": {"$ref": "#/$defs/host"},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "onion": {"type": "string", "pattern": "^[a-z2-7]{56}\\.onion$"},
              "onion_port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "tls": {"type": "boolean"}
            }
          }
        }
      }
    },
    "notices": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "severity", "title", "text"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "severity": {"enum": ["info", "warning"]},
          "title": {"$ref": "#/$defs/text80"},
          "text": {"$ref": "#/$defs/text500"},
          "url": {"$ref": "#/$defs/url"},
          "starts_at": {"$ref": "#/$defs/timestamp"},
          "ends_at": {"$ref": "#/$defs/timestamp"},
          "projects": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/id"}}
        }
      }
    },
    "revoked_keys": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/keyid"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"},
    "keyid": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "chain": {"enum": ["mainnet", "floonet"]},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"},
    "url": {"type": "string", "maxLength": 512, "pattern": "^https://[a-z0-9.-]+(:[0-9]{1,5})?(/[\\x21-\\x7e]*)?$"},
    "host": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"},
    "text64": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff\\s]([^\\x00-\\x1f\\x7f-\\x9f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff]*[^\\x00-\\x1f\\x7f-\\x9f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff\\s])?$"},
    "text80": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff\\s]([^\\x00-\\x1f\\x7f-\\x9f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff]*[^\\x00-\\x1f\\x7f-\\x9f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff\\s])?$"},
    "text280": {"type": "string", "minLength": 1, "maxLength": 280, "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff\\s]([^\\x00-\\x1f\\x7f-\\x9f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff]*[^\\x00-\\x1f\\x7f-\\x9f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff\\s])?$"},
    "text500": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff\\s]([^\\x00-\\x1f\\x7f-\\x9f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff]*[^\\x00-\\x1f\\x7f-\\x9f\\u200b-\\u200f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ufeff\\s])?$"}
  }
}
