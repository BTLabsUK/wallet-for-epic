{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://btlabs-epic.github.io/schema/btlabs-envelope-1.schema.json",
  "title": "BT Labs signed file (DSSE v1 envelope)",
  "description": "FORMAT.md §1. The signature covers PAE(payloadType, base64-decoded payload).",
  "type": "object",
  "required": ["payloadType", "payload", "signatures"],
  "properties": {
    "payloadType": {"type": "string", "pattern": "^application/vnd\\.btlabs\\.[a-z0-9.-]+\\+json$"},
    "payload": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["keyid", "sig"],
        "properties": {
          "keyid": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
          "sig": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
        }
      }
    }
  }
}
