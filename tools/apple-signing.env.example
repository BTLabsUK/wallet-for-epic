# Settings for tools/apple-sign.sh: copy to ~/.config/epic-apple-signing/signing.env (or set
# APPLE_SIGNING_ENV to another path), chmod 600, and fill in. This file is sourced by bash.
# It names files and ids only; the keys themselves live in APPLE_KEYS_DIR, outside every
# repository, on encrypted storage (tools/apple-release.md, "Keys: where they live").

# The 10-character Team ID (developer.apple.com, Membership details). Frozen after the first
# signed release.
APPLE_TEAM_ID=

# Where csr/p12/api-key put and find the key files (default: keys/ beside this file). Mode 700.
#APPLE_KEYS_DIR=

# For `csr`: the name and contact on the certificate signing request.
APPLE_CSR_NAME="BT Labs"
APPLE_CSR_EMAIL=
APPLE_CSR_COUNTRY=GB

# Developer ID Application (macOS .app and .dmg), from `csr devid` + `p12 devid <.cer>`.
DEVID_P12=
DEVID_P12_PASSWORD_FILE=

# Apple Distribution (iOS App Store / TestFlight), from `csr dist` + `p12 dist <.cer>`.
DIST_P12=
DIST_P12_PASSWORD_FILE=

# The App Store provisioning profile of uk.btlabs.wallet.mobile (.mobileprovision).
IOS_PROFILE=

# App Store Connect team API key (Users and Access, Integrations, Team Keys): its id, the issuer
# id shown on that page, the AuthKey_<id>.p8 (downloadable once), and rcodesign's JSON form of
# it from `api-key` (notarisation).
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_P8=
ASC_API_KEY_JSON=

# Tools, when not on PATH.
#RCODESIGN=/opt/rcodesign/rcodesign
#SEVENZIP=7zz

# Where signed output goes (default ./apple-signed).
#APPLE_SIGN_OUT=

# Only for the dry run made by `test-identity`: self-signed certificates, nothing goes to Apple.
#APPLE_SIGN_TEST=1
