<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Network lost and regained (NetworkWatch.kt), so tor is refreshed or restarted. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- The in-app updater's install permissions are in src/updater/AndroidManifest.xml:
         build.gradle.kts merges them into the build from our own page only (WFE_DIST,
         https://docs.btlabs.uk/developers/build/variants/). -->
    <!-- QR scanning on the send screen (camera + flutter_zxing, no Google code). Asked for when the scanner opens; devices without a camera can still install
         the app. The camera plugin's audio, storage and camera.any lines are not wanted: the
         scanner records no sound and saves no pictures. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="false"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
    <!-- No auto backup and no device-to-device transfer: Keystore keys do not move to a new
         device, so restored secure storage would be unreadable, and the wallet database,
         metadata and logs stay on this one. allowBackup and fullBackupContent cover Android 11
         and lower; dataExtractionRules covers 12+, where transfer ignores allowBackup. The
         recovery phrase is the backup. -->
    <application
        android:label="Epic Cash Mobile"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher">
        <!-- singleTask: a payment link or file opened from another app (Telegram, a browser)
             reaches the running wallet through onNewIntent instead of starting a second
             instance inside that app's task. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:enableOnBackInvokedCallback="true"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <!-- Flutter would otherwise hand a VIEW link to the Navigator as the initial route or a
                 pushed route. Links reach Dart only through epic_wallet/incoming_link. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"/>
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Transaction files (.tx, .tx.response) opened or shared from other apps. Chat and
                 mail apps label them as generic binary or JSON; the wallet checks the content. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:mimeType="application/octet-stream"/>
                <data android:mimeType="application/json"/>
            </intent-filter>
            <!-- Payment links (epic:, epiccash:). No host and no autoVerify: custom schemes cannot
                 be verified. The wallet only opens its review screen for them. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="epic"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="epiccash"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/octet-stream"/>
                <data android:mimeType="application/json"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- image_picker (pulled in by flutter_zxing) asks Play services for its photo picker
             backport; no build has Google Play services code. -->
        <service android:name="com.google.android.gms.metadata.ModuleDependencies" tools:node="remove"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
