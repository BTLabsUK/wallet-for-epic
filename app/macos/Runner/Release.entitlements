<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No sandbox: the data folder is ~/.epic_cash_desktop in the real home folder (lib/src/data_folder_io.dart), as the old GUI wallet keeps ~/.epic-gui, and the built-in node and tor run from the bundle. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
