// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name: the .app and the menu bar.
PRODUCT_NAME = BT Wallet

// The executable inside the bundle (Info.plist's CFBundleExecutable); tools/build-apple.sh and
// tools/apple-sign.sh name it.
EXECUTABLE_NAME = btwallet

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = uk.btlabs.btwallet.macos

// Apple silicon only: the built-in node has no Intel build (tools/build-apple.sh also sets
// FLUTTER_MACOS_ARM64_ONLY for release builds).
EXCLUDED_ARCHS = x86_64

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 BT Labs. All rights reserved.

// Signed to run locally (ad hoc), with no team and no Apple Development certificate. The macOS
// project does not read app/Signing.xcconfig (only the iOS one does): tools/build-apple.sh
// mac-release signs the app again with the team's Developer ID afterwards. The target keeps
// CODE_SIGN_STYLE = Automatic in project.pbxproj; with identity "-" and no team that is "Sign to
// Run Locally".
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =
