  "helpTitle": "Help",
  "@helpTitle": {
    "description": "Title of the help page."
  },
  "helpWaitingQuestion": "Why does my payment say \"Waiting for recipient\"?",
  "@helpWaitingQuestion": {
    "description": "A question on the help page. Quote the status chip's text exactly as txStatusWaitingRecipient translates it."
  },
  "helpWaitingAnswer": "An Epic Cash payment is built by both wallets together: yours starts it, the recipient's wallet accepts it, then yours finishes it. Epic's epicbox service holds your payment for about a week, until the recipient's wallet comes online and answers. Until then the amount stays locked in your wallet, so you cannot spend it twice. If the payment is not completed, your wallet cancels it by itself after {days, plural, =1{1 day} other{{days} days}} and unlocks the amount.",
  "@helpWaitingAnswer": {
    "description": "Answer on the help page. epicbox is the relay service that carries payments (a proper name).",
    "placeholders": {
      "days": {
        "type": "int"
      }
    }
  },
  "helpCancellingQuestion": "Should I cancel a payment?",
  "@helpCancellingQuestion": {
    "description": "A question on the help page."
  },
  "helpCancellingAnswer": "Usually you do not need to: a payment that is not completed cancels itself after {days, plural, =1{1 day} other{{days} days}} and unlocks the amount. To stop one sooner, for example when the recipient says they will never answer, open it while it still says \"Waiting for recipient\" and tap Cancel payment; you would then have to send it again. A payment that is already confirming cannot be cancelled. Payments made with older versions of this app do not cancel themselves: if one has waited more than two weeks, cancel it and send again.",
  "@helpCancellingAnswer": {
    "description": "Answer on the help page. \"Waiting for recipient\" is the status chip (txStatusWaitingRecipient) and Cancel payment the button on the payment's details screen: use the same words as those.",
    "placeholders": {
      "days": {
        "type": "int"
      }
    }
  },
  "helpReceivingQuestion": "Why must I keep the app open to receive?",
  "@helpReceivingQuestion": {
    "description": "A question on the help page."
  },
  "helpReceivingAnswer": "Your wallet has to accept every incoming payment, and it can only do that while the app is open and connected to epicbox. A payment sent while the app is closed waits in epicbox for about a week and arrives the next time you unlock. After that epicbox deletes it; if the sender uses this app, their wallet cancels it by itself after {days, plural, =1{1 day} other{{days} days}}, and they can send it again. Once your wallet accepts a payment, the sender's wallet must finish it; until then it shows as Waiting for sender.",
  "@helpReceivingAnswer": {
    "description": "Answer on the help page. epicbox is the relay service that carries payments (a proper name). Waiting for sender is the status chip (txStatusWaitingSender): use the same words.",
    "placeholders": {
      "days": {
        "type": "int"
      }
    }
  },
  "helpConfirmationsQuestion": "What are confirmations and why {count}?",
  "@helpConfirmationsQuestion": {
    "description": "A question on the help page: why the wallet waits for this many blocks.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "helpConfirmationsAnswer": "A confirmation is a new block added to the Epic Cash blockchain after the one that holds your payment; a block arrives about once a minute. Each block makes it harder to undo the payment. After {count, plural, =1{1 confirmation, about 1 minute} other{{count} confirmations, about {count} minutes}}, a payment shows as Completed and received coins can be spent; that is the Epic wallet's standard.",
  "@helpConfirmationsAnswer": {
    "description": "Answer on the help page. Completed is the status chip (txStatusCompleted): use the same word.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "helpHistoryQuestion": "Why is my history missing after a restore?",
  "@helpHistoryQuestion": {
    "description": "A question on the help page."
  },
  "helpHistoryAnswer": "The recovery phrase brings back your balance: the wallet scans the blockchain for coins that belong to it. Who you paid, your notes and most dates are never stored on the blockchain, so a restore cannot find them. If you saved a history backup, import it in Settings, under Payment history, Import history backup, to get them back. The backup must be a copy you kept outside the lost phone, for example in email or cloud storage.",
  "@helpHistoryAnswer": {
    "description": "Answer on the help page. Settings, Payment history and Import history backup are the names on the settings screen (settingsTitle, settingsSectionHistory, settingsImportHistory): use the same words."
  },
  "helpAddressQuestion": "Does my address ever change?",
  "@helpAddressQuestion": {
    "description": "A question on the help page."
  },
  "helpAddressAnswer": "Your address is made from your recovery phrase and the epicbox server you use, and it ends in @ and that server's name. It stays the same as long as you keep the same epicbox server. If you pick another one in network settings, your address changes, so give the new one to people who pay you.",
  "@helpAddressAnswer": {
    "description": "Answer on the help page. epicbox is the relay service that carries payments (a proper name)."
  },
  "helpPhraseQuestion": "What is the recovery phrase and who can see it?",
  "@helpPhraseQuestion": {
    "description": "A question on the help page."
  },
  "helpPhraseAnswer": "The recovery phrase is a list of words that is the key to your money: anyone who has it can take your coins, and with it you can restore your wallet on a new phone. The app shows it only after you enter your PIN, and it never sends it anywhere. Write it on paper, keep it somewhere safe, and never share it or type it into a website.",
  "@helpPhraseAnswer": {
    "description": "Answer on the help page."
  },
  "helpFeesQuestion": "What does the fee pay for?",
  "@helpFeesQuestion": {
    "description": "A question on the help page."
  },
  "helpFeesAnswer": "The fee goes to the miners who add your payment to the blockchain. It is usually a small fraction of an EPIC and depends on how many coins your wallet combines to make the payment. You see the exact fee before you send.",
